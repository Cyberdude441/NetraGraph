# ============================================================
# NetraGraph Production Environment Configuration Template
# Placeholders only - Never commit real production secrets
# ============================================================

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/netragraph
DATABASE_SYNC_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/netragraph
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# JWT & Authentication Secrets
JWT_SECRET_KEY=generate-a-strong-random-32-byte-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Security & Rate Limiting
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com

# Email Delivery Provider (smtp, console, mock)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-officer-service-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=netragraph-security@gmail.com
SMTP_FROM_NAME=NetraGraph Security Division
SMTP_USE_TLS=True

# Browser Cookie Security (Set True when serving over HTTPS)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Neo4j Graph Engine Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
