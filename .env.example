# NetraGraph AI Environment Configuration Template
# Copy this file to .env and insert your real keys

# AI Providers
NVIDIA_NEMOTRON_API_KEY=your_nvidia_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
DEFAULT_AI_PROVIDER=nemotron

# Primary Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Open Government Data (data.gov.in) Official Connector
DATAGOV_API_KEY=your_datagov_in_api_key_here

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
