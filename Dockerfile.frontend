# ============================================================
# NetraGraph Frontend Production Multi-Stage Dockerfile
# Framework: React 19 + Vite 8 + TanStack Router + Tailwind CSS
# ============================================================

# Stage 1: Static Asset Compilation Stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code & configuration
COPY frontend/ .

# Compile optimized production bundle
RUN npm run build


# Stage 2: Minimal Production Nginx Runtime Stage
FROM nginx:1.27-alpine-slim AS runner

# Security metadata & labels
LABEL org.opencontainers.image.title="NetraGraph Analyst Frontend" \
      org.opencontainers.image.description="National Cyber Cell Investigation Portal UI" \
      org.opencontainers.image.version="2.5.0" \
      org.opencontainers.image.vendor="NetraGraph Security Division"

# Install curl for container healthcheck
RUN apk add --no-cache curl

# Remove default Nginx welcome site
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/.output/public/ /usr/share/nginx/html/

# Copy custom Nginx SPA configuration
COPY docker/nginx/frontend-nginx.conf /etc/nginx/conf.d/default.conf

# Setup non-root execution permissions for nginx
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid

EXPOSE 3000

# Container liveness healthcheck probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

USER nginx

CMD ["nginx", "-g", "daemon off;"]
