{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Gateway & Traffic Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "HTTP Request Throughput (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(netragraph_http_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "HTTP Latency P95 (seconds)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(netragraph_http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "P95 {{endpoint}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "HTTP Status Codes & Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status_code) (rate(netragraph_http_requests_total[1m]))",
          "legendFormat": "Status {{status_code}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Database & Knowledge Graph Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 6,
      "title": "PostgreSQL Pool Utilization",
      "type": "gauge",
      "targets": [
        {
          "expr": "netragraph_db_pool_utilization",
          "legendFormat": "PostgreSQL Pool"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 7,
      "title": "Neo4j Knowledge Graph Operations (ops/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (operation, status) (rate(netragraph_neo4j_queries_total[1m]))",
          "legendFormat": "{{operation}} ({{status}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "id": 8,
      "title": "Neo4j Query Latency Average",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(netragraph_neo4j_query_duration_seconds_sum[1m]) / rate(netragraph_neo4j_query_duration_seconds_count[1m])",
          "legendFormat": "{{operation}} avg latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "title": "Machine Learning Models A–E Real-Time Inference",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 10,
      "title": "ML Inference Throughput per Model (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (model_name) (rate(netragraph_ml_inference_total[1m]))",
          "legendFormat": "Model: {{model_name}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 11,
      "title": "ML Model Computation Latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(netragraph_ml_inference_duration_seconds_bucket[1m])) by (le, model_name))",
          "legendFormat": "{{model_name}} P95"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 12,
      "title": "Authentication & Security Operations Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 25 },
      "id": 13,
      "title": "Authentication & OTP Security Events (5m Rate)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (event_type, status) (rate(netragraph_auth_events_total[5m]))",
          "legendFormat": "{{event_type}} - {{status}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["netragraph", "telemetry", "production", "cybercell"],
